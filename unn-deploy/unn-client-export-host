#!/usr/bin/env bash
# Mothership: a fixed command for the desktop updater. No paths from callers.
set -euo pipefail
[ "$#" -eq 1 ] || exit 2
case $1 in info|archive) ;; *) exit 2 ;; esac
exec python3 /opt/arcwright-personal/provision.py guest sudo -n /usr/local/lib/unn-openbot/unn-client-export "$1"
